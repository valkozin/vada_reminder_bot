# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=7123456789:AAFg...

# Необязательно: ID пользователей через запятую, которым разрешён доступ
# (узнать свой ID можно у @userinfobot). Пусто = доступ всем.
TELEGRAM_ALLOWED_USER_IDS=

# Необязательно, но рекомендуется: секрет, который Telegram присылает в заголовке
# X-Telegram-Bot-Api-Secret-Token. Защищает вебхук от посторонних запросов.
# Задав его здесь, обязательно переустановите вебхук через /api/setup?...&setWebhook=1
TELEGRAM_WEBHOOK_SECRET=

# --- Шифрование текстов напоминаний в базе ---
# НЕОБЯЗАТЕЛЬНО. Если оставить пустым, ключ выводится из TELEGRAM_BOT_TOKEN —
# шифрование работает само, хранить ничего не нужно.
# Задавать явно стоит только если планируете менять токен бота: смена токена
# делает тексты, зашифрованные выведенным из него ключом, нечитаемыми.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Upstash Redis (REST) ---
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# --- Защита cron-эндпоинта и /api/setup ---
CRON_SECRET=super_secret_cron_key_change_me
