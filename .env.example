# Telegram Bot Config
TELEGRAM_BOT_TOKEN=7123456789:AAFg...
# Optional: comma-separated Telegram User IDs allowed to use the bot (e.g. 12345678,87654321). Leave empty to allow all.
TELEGRAM_ALLOWED_USER_IDS=

# Upstash Redis REST Config
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Secret Key for Cron endpoint protection
CRON_SECRET=super_secret_cron_key_change_me
